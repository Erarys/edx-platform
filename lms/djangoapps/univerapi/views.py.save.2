import requests
import jwt  # Убедитесь, что установлен PyJWT версии 1.x: pip install "PyJWT<2"


def decode_token_and_fetch_profile(token, secret_key='$ecRet@3#$2958GPIs!1'):
    decoded_token = jwt.decode(token, secret_key, algorithms=['HS256'])
    uname = decoded_token.get('uname', None)
    upwd = decoded_token.get('upwd', None)

    if uname and upwd:
        login_url = "https://univerapi.kaznu.kz/user/loginMoodle"
        credentials = {
            'login': uname,
            'password': upwd
        }

        session = requests.Session()
        response = session.post(login_url, data=credentials)
        response_data = response.json()

        if response.status_code == 200 and response_data.get('code') == 0:
            profile_url = "https://univerapi.kaznu.kz/teacher/profile"
            profile_response = session.get(profile_url)
            profile_data = profile_response.json()
            roles = "teacher"
            
            if profile_data.get('code') == 1:
                profile_url = "https://univerapi.kaznu.kz/student/profile"
                profile_response = session.get(profile_url)
                profile_data = profile_response.json() 
                roles = "student"
            
            surname = ''
            name = ''
            birth_year = ''
            gender = ''
            stage = ''

            if roles == "teacher":
                user_data = profile_data['data'][0]
                surname = user_data['sname']
                name = user_data['name']
                date_of_birth = user_data['dateOfBirth']
                birth_year = date_of_birth.split('.')[-1]

            if roles == "student":
                surname = profile_data['data'][1][0]['sname'].split(':')[1]
                name = profile_data['data'][1][1]['name'].split(':')[1]
                gender = profile_data['data'][1][4]['sex'].split(':')[1]
                stage = profile_data['data'][0][4]['stage'].split(':')[1]

                # Обработка stage и gender в одну строку
                

            return surname, name, gender, stage, birth_year

    return None, None, None, None, None  # Возвращаем None, если авторизация не удалась


